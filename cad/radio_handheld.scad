// ============================================================
//  WiFi-рация Ай-Шефф — переносной корпус (аккумулятор 18650)       v3 (28.09.2026)
//  Параметрическая модель OpenSCAD (snapshot 2026, backend Manifold). Числа — в шапке.
//
//  Брусок 68 × 38 × 170 мм (Ш × Т × В):
//    спереди — динамик за белым диском, вокруг решётки светится кольцо WS2812;
//              внизу — отверстие микрофона, посередине — надпись «АЙ-ШЕФФ»;
//    левый бок — кнопка «говорить» (антивандальная 16 мм);
//    верх — регулятор громкости (KY-040) и выключатель (тумблер M6, стоит поперёк: рычажок ходит к лицу и к спине);
//    низ — гнездо зарядки USB-C модуля заряда.
//
//  v3 (по сборке прототипа 28.09): ВСЁ железо крепится к лицевой части, задняя крышка — просто крышка,
//  к ней не идёт ни одного провода (в v2 через стык шло ~20). Сняли крышку — всё на виду:
//    внизу:     микрофон под планкой (2 самореза), модуль заряда стоит на ребре в пазу, усилитель в гнезде на защёлках;
//    середина:  плата ESP32-S3 (модулем к лицу, штырьками к вам) — лежит на площадках, углы у антенны под
//               козырьками, посередине прижата лапкой (1 саморез); держатель 18650 на 2 саморезах через свои
//               отверстия в дне (изнутри); между платой и аккумулятором — канал для проводов с 2 мостиками под стяжки;
//    верх:      полка за динамиком (2 самореза) прижимает динамик вместе с кольцом и белым диском
//               и держит обе клеммы; регулятор штырьками ВПРАВО — от тумблера (в v2 они упирались в тумблер).
//  Корпус: ребро у лица скосом 45° (в v2 висело в воздухе — полосы и жгут на боку), надпись трафаретом.
//
//  Размеры — замеры автора 27 и 28.09 (все числа: cad/measurements.md). Гнёзда клемм, держателя и
//  динамика в v2 были по размеру. Не мерили: толщину платы усилителя (взята 1,6).
//
//  Детали (саморезы по пластику: 5 шт. 3×10 внутри + 2 шт. 3×12 на держатель 18650 + 4 шт. 3×12 потай на крышку):
//           front      — лицевая часть со стенками: печать ЛИЦОМ НА СТОЛ, без поддержек
//           back       — задняя крышка: 4 самореза 3×12 (потай)
//           shelf      — полка за динамиком: прижимает динамик, держит 2 клеммы (2 самореза)
//           dk_arm     — лапка платы ESP (1 саморез + штырёк-фиксатор)
//           mic_cap    — планка микрофона: прижимает плату между столбиками штырьков (2 самореза)
//           shaft_gauge — пробник вала регулятора: 3 отверстия, какое сядет лучше (≈5 минут)
//           lens       — диск динамика со светящимся кольцом: печатать БЕЛЫМ PLA/PETG
//           spacer     — прокладка между кольцом светодиодов и динамиком
//           knob       — ручка регулятора
//           enc_spacer — кольцо-проставка регулятора: запасная, нужна только при длинной резьбе втулки
//           coupon, edge_test — пробники
//
//  Отверстия в стенках (кнопка, регулятор, тумблер) — «капелькой» остриём к спине: при печати лицом
//  на стол их верх не провисает.
//
//  Экспорт (из папки проекта):
//    openscad --backend manifold --export-format binstl -D 'part="front_print"' -o stl/front.stl cad/radio_handheld.scad
//  Проверки (экспорт должен быть ПУСТЫМ): check_inside, check_walls, check_lid, check_parts
// ============================================================

part = "assembly";

$fn = 72;
eps = 0.01;

// ---------- Корпус ----------
W = 68;            // ширина
T = 38;            // толщина (от лица до спины)
H = 170;           // высота
wall = 2.4;        // стенки и лицо (≈ 5–6 линий сопла 0,4)
back_t = 2.4;      // задняя крышка
r_v = 9;           // скругление длинных рёбер у лица; от лица оно начинается скосом 45° (см. plan0)
r_b = 2;           // и у спины: маленькое, чтобы стык с крышкой и головки саморезов легли на плоскость

// ---------- Покупные детали ----------
spk_sq = 32;       // динамик Chip-Dip FBS3232 (8 Ом 3 Вт): квадратный фланец 32×32×2,2
spk_flange = 2.2;
spk_body_d = 28.7; // магнит Ø27,3, с лепестками выводов по кругу Ø28,7 (замер 28.09)
spk_depth = 14.7;  // полная глубина (замер 27.09: 32×32×14,7)
ring_od = 50;      // кольцо WS2812B 12 шт.: 50/36 мм (замер 27.09 — Ø50)
ring_id = 36;
ring_h = 2.5;      // плата + светодиод (замер 28.09; было 3,4 — динамик в v1 болтался на 0,9)
ptt_hole = 16.2;   // антивандальная кнопка PBS-28B-2 D-16 (Chip-Dip): резьба M16
ptt_body = 20.3;   // в корпусе: глубина 20,3 и Ø14,6 (замер 28.09)
ptt_d = 14.6;
sw_hole = 6.2;     // микротумблер MTS-101 (Chip-Dip): отверстие Ø6
sw_depth = 15;     // корпус под панелью 14 × 12,7 × 7,8 (замер 28.09) + 1 на пайку
sw_body = [7.8, 12.7];
enc_bush_d = 7.0;  // энкодер KY-040: втулка M7, резьба 12 мм (замер 27.09)
enc_pcb = [26, 19.0];        // плата без штырьков; вдоль x: 32 мм вместе со штырьками (замер)
enc_pin_side = 14;           // от оси до края платы со штырьками (замер: до концов штырьков 20, штырьки ≈6)
enc_pins = 6;                // штырьки целиком: укорачивать больше не нужно — смотрят от тумблера в свободный угол
enc_plug = 14;               // колодка Dupont мама на штырьках: от края платы 14 мм, дальше провод загибается вниз
enc_pocket = 1.2;            // карман в правой стенке у колодок: стенка там 1,2 вместо 2,4
enc_spacer_t = 3;            // кольцо-проставка (запасная деталь): только если резьба втулки длиннее обычной
enc_drop = 0;
knob_d = 20;
knob_h = 14;
shaft_d = 6.35;    // вал Ø5,8 с лыской 4,2 (замер 28.09); ручка v1 (6,1/4,6) шла очень туго: печать сужает отверстие ≈0,3
shaft_flat = 4.75; // от лыски до противоположного края отверстия; вход — с фаской 0,5. Проверка — пробник shaft_gauge
shaft_chamfer = 0.5;
shaft_depth = 10;
mic_pcb_d = 13.4;  // INMP441 (замер 28.09): плата Ø13,4 толщиной 0,7, с деталями 1,7; выемки по бокам — между ними 11,9
mic_smd = 1.7;     // плата + детали: деталями (и капсюлем) к лицу, штырьки к спине
mic_cols = 3.81;   // 2 столбика по 3 штырька: SD·VDD·GND и SCK·WS·L/R — на ±3,81 от центра: 29.09 планка шириной 6
                   // не прошла между колодками (думали ±5,08) — автор подпилил, просит у́же на 3 мм
mic_hole_d = 2.0;
bat_holder = [20.5, 77.5, 21];     // держатель BeilaMoo (замер 28.09): ширина, длина, высота
bat_holes = 55;                    // 2 отверстия Ø3 в дне на 55 мм — саморезы 3×12 изнутри в бобышки
bat_lift = 10;                     // бобышки 10 мм (было 6 под 3×8 — у автора 3×12, 29.09 кончики вылезли на лице):
                                   // саморез 12 − дно держателя ≥1 = до 11 мм в бобышку + лицо, под кончиком ≥1,2 мм лица
bat_screw_in = 11.2;               // глубина отверстия под саморез от верха бобышки
dk = [28, 63];               // плата ESP32-S3 (клон YD, замер 28.09); штырьки 2 × 22 по длинным краям, шаг 2,54
dk_mod = 3.1;                // крышка модуля над платой (плата + крышка = 4,7, замер)
dk_usb = 3.3;                // гнёзда USB-C над платой (каталог)
dk_pin = 8;                  // штырьки от платы (замер): пластик 2,5 + 5,5
dk_ant = 6.3;                // антенна модуля выступает за край платы (по фото, ESP32-S3-WROOM-1: 25,5 − 19,2)
dk_end = (dk[1] - 22 * 2.54) / 2;   // край платы без штырьков (≈3,6 с каждого конца)
chg = [20, 26, 4];           // модуль заряда (замер 27.09): ширина, длина (USB-C на коротком краю), толщина
amp = [17.3, 18.8];          // усилитель MAX98357A (замер 28.09): гребёнка на краю 17,3; штырьки — со стороны деталей
amp_t = 1.6;                 // толщина платы усилителя — не мерили, типовая
clamp = [19.4, 29.8, 9.6];   // клемма СМК 221-415 (замер 27.09): поперёк, вдоль, толщина (гнездо v2 — по размеру)

// ---------- Раскладка (x — поперёк, y — от лица к спине, z — снизу вверх) ----------
lens_z = 136;      // центр диска динамика
mic_z = 19;        // над микрофоном — плата ESP (с z = 36,6, антенна модуля — с 30,3)
ptt_z = 108;       // выше на 2: штырьки платы ESP кончаются в 4,7 мм под кнопкой (в v1 задевали её)
ptt_y = 20;
enc_xy = [2, 24];           // регулятор: штырьки ВПРАВО (+x) — к свободному углу, от тумблера. 29.09: с колодками
                            // мама-мама (14 мм) не помещался у стенки — сдвинут на 5 мм к тумблеру (до корпуса
                            // тумблера 5 мм, от ручки до гайки тумблера ≈5 мм) + карман в стенке enc_pocket
sw_xy = [-19, 24];          // тумблер повёрнут поперёк (13,2 мм — от лица к спине)
dk_pos = [-30.6, 36.6];     // плата: левый нижний угол (x, z); антенна ВНИЗУ (выступает до 30,3), USB-C вверху;
                            // у лица стенка изнутри скруглена — край платы в 0,6 от неё
dk_y = wall + 1 + dk_usb;   // лицевая сторона платы: гнёзда USB-C и крышка модуля лежат на площадках
bat_pos = [9.4, 30.4];      // держатель 18650: (x, z) — у правой стенки. 3.1: на 1,3 ближе к каналу — поднятый на бобышки
                            // 10 мм, он краем лёг бы в 0,2 мм под бортик крышки (проверка 29.09)
chg_pos = [-23.2, 9.2];     // модуль заряда стоит на ребре в пазу: x левой грани, y грани у лица; USB-C вниз
amp_pos = [29.1 - amp[0], 9.8];   // усилитель: левый нижний угол (x, z) — внизу справа (у лица стенка скруглена)
shelf_y = 19.5;             // полка за динамиком: грань пятачка, что давит на магнит (магнит — на 19,8: прижим 0,3)
shelf_p = 22;               // сама плита полки — на 2,5 выше магнита: под ней проходят провода с лепестков динамика
shelf_t = 3;
clamp_x = [-20.2, 0.8];     // клеммы на полке: x левого края каждой, вводы проводов — ВНИЗ
clamp_z = 116.6;
shelf_post = [28.1, 126];   // стойки полки (±x, z)
arm_post = [1.5, 82];       // стойка лапки платы (x, z)
mic_post = [[0, mic_z - 13], [0, mic_z + 13]];   // стойки планки микрофона — под и над ним
tie_z = [52, 92];           // мостики под стяжки в канале между платой и аккумулятором

// ---------- Диск динамика ----------
lens_d = 54;       // диск
lens_t = 1.6;
lens_open = 52.6;  // проём в лице (диск лежит на уступе)
cup_h = 8;         // стакан под кольцо светодиодов (изнутри)
grille_r = 15.5;   // решётка внутри кольца

// ---------- Крепёж ----------
screw_pilot = 2.5;           // саморез 3 мм в PLA
screw_clear = 3.4;
boss_d = 7;
boss_in = wall + boss_d / 2 - 0.4;
lip_h = 2.0;
lip_t = 1.2;

inner_w = W - 2 * wall;
inner_t = T - wall - back_t;

// бобышки крышки: верхняя правая ниже (z = 150), чтобы не мешать штырькам регулятора; нижние — у самого дна
boss_pts = [[-W / 2 + boss_in, wall + boss_d / 2], [W / 2 - boss_in, wall + boss_d / 2],
            [-W / 2 + boss_in, H - boss_in - 6], [W / 2 - boss_in, 150]];

// ============================================================
//                         помощники
// ============================================================

module rrect(w, h, r) { offset(r = r) offset(delta = -r) square([w, h], center = true); }
module box(x0, x1, y0, y1, z0, z1) translate([x0, y0, z0]) cube([x1 - x0, y1 - y0, z1 - z0]);
// стойка вдоль y (от лица к спине); отверстия под саморезы режет pilots() — после всех добавок
module post(x, z, y0, y1, d = 6.5) { translate([x, y0 - eps, z]) rotate([-90, 0, 0]) cylinder(d = d, h = y1 - y0 + eps, $fn = 40); }
module pilot(x, z, y1, depth) { translate([x, y1 - depth, z]) rotate([-90, 0, 0]) cylinder(d = screw_pilot, h = depth + 1, $fn = 24); }
module pilots() {
  for (p = mic_post) pilot(p[0], p[1], mic_post_y, 7.4);                  // саморез 3×10: планка 2,5 + 7,5
  for (s = [-1, 1]) pilot(s * shelf_post[0], shelf_post[1], shelf_p, 8);  // полка 3 + 7
  pilot(arm_post[0], arm_post[1], arm_y0, 8);                             // лапка 3 + 7
  for (p = bat_boss) pilot(p[0], p[1], wall + bat_lift, bat_screw_in);   // 3×12 изнутри держателя: дно отверстия в 1,2 от лица
}
// плоская 2D-фигура в плоскости (x, z), вытянутая по y от y0 на h
module xz(y0, h) { translate([0, y0 + h, 0]) rotate([90, 0, 0]) linear_extrude(h) children(); }
// поза печати: плоскость y = y0 ложится на стол, +y — вверх (или вниз, если flip)
module y_on_bed(y0, flip = false) {
  if (flip) translate([0, 0, y0]) rotate([-90, 0, 0]) children();
  else translate([0, 0, -y0]) rotate([90, 0, 0]) children();
}

// профиль в плане (XY): лицо при y = 0, спина при y = T.
// Ребро у лица: от плоскости лица — скос 45°, дальше дуга r_v до бока. Раньше была чистая дуга (+ фаска):
// при печати лицом на стол её первые 2,6 мм висели в воздухе под 58–74°, слайсер печатал их «нависанием»
// на 10 мм/с, края загибались — на боку комплекта 1 получились полосы и жгут (разбор G-code 28.09).
// Скос 45° печатается чисто, а плоское лицо стало шире выемки диска (57,5 > 54,4): её край больше не
// прорезает ребро. У спины то же самое в малом радиусе.
module plan0() {
  k = 2 - sqrt(2);                       // скос 45°, касательный к дуге: на лице он начинается в k·r от бока
  hull() for (s = [-1, 1]) {
    translate([s * (W / 2 - r_v), r_v]) circle(r = r_v);
    translate([s * (W / 2 - k * r_v), 0.01]) square(0.02, center = true);
    translate([s * (W / 2 - r_b), T - r_b]) circle(r = r_b);
    translate([s * (W / 2 - k * r_b), T - 0.01]) square(0.02, center = true);
  }
}
module plan(o = 0) { offset(delta = o) plan0(); }

// «капелька» остриём вдоль +Y (к спине): отверстие в стенке, которое при печати лицом на стол лежит на боку
module teardrop(d, cap = 0.6) {
  r = d / 2;
  hull() {
    circle(d = d);
    intersection() {
      polygon([[-r / sqrt(2), r / sqrt(2)], [r / sqrt(2), r / sqrt(2)], [0, r * sqrt(2)]]);
      translate([-r, 0]) square([2 * r, r + cap]);
    }
  }
}

// окно гнезда USB-C в дне: модуль стоит на ребре, гнездо смотрит вниз; окно пропускает вилку целиком
// при любой стороне модуля (гнездо может быть смещено к одной из граней толщины 4 мм)
usb_c = [chg_pos[0] + chg[2] / 2, chg_pos[1] + chg[0] / 2];   // центр окна (x, y)
module usb_window() { translate([usb_c[0], usb_c[1], -1]) linear_extrude(wall + 1 + eps) rrect(7.6, 13.5, 1.6); }

module body_outer() { linear_extrude(H) plan(); }   // скосы 45° уже в профиле plan0

// ============================================================
//                        лицевая часть
// ============================================================

module front_solid() {
  difference() {
    intersection() {
      body_outer();
      translate([-W, -1, -1]) cube([2 * W, T - back_t + 1, H + 2]);   // спина — отдельная крышка
    }
    // полость (продлена за стык, чтобы срез был чистым)
    translate([0, 0, wall]) linear_extrude(H - 2 * wall)
      intersection() {
        hull() { plan(-wall); translate([0, 5]) plan(-wall); }
        translate([-W, wall]) square([2 * W, T]);
      }
  }
}

// --- гнёзда и стойки внутри (всё растёт от лица — печатается без поддержек) ---
module board_seat() {
  x0 = dk_pos[0]; x1 = dk_pos[0] + dk[0]; z0 = dk_pos[1]; z1 = dk_pos[1] + dk[1]; xc = (x0 + x1) / 2;
  box(xc - 6, xc + 6, wall - eps, dk_y - dk_mod, z0 + 3, z0 + 16);        // площадка под крышкой модуля
  box(x0 + 3.5, x1 - 3.5, wall - eps, dk_y - dk_usb, z1 - 7, z1 - 0.5);   // площадка под гнёздами USB-C
  box(x1 + 0.2, x1 + 1.4, wall - eps, dk_y + 1.6, z0 + 9, z1 - 25);       // направляющая справа (слева — стенка)
  // углы у антенны (антенна модуля выступает за край платы посередине, углы свободны): упор + козырёк над углом.
  // Плату заводят углами под козырьки, потом кладут на площадки и прижимают лапкой.
  for (xa = [[x0 - 0.4, x0 + 4], [x1 - 4, x1 + 0.2]]) {
    box(xa[0], xa[1], wall - eps, dk_y + 3.2, z0 - 1.4, z0 - 0.2);
    box(xa[0], xa[1], dk_y + 2.0, dk_y + 3.2, z0 - 1.4, z0 + 0.8);   // козырёк: зазор до платы 0,4, выступ 0,8 (печатается чисто)
  }
  // упоры у конца с USB-C (мимо гнёзд): плата не уползёт вверх из-под козырьков, если дёрнуть провода
  for (xa = [[x0 - 0.4, x0 + 3], [x1 - 3, x1 + 0.2]]) box(xa[0], xa[1], wall - eps, dk_y + 1.6, z1 + 0.2, z1 + 1.4);
  // стойка лапки: саморез + штырёк-фиксатор (лапка не проворачивается)
  translate([arm_post[0] - 3, wall - eps, arm_post[1] - 6]) cube([6, arm_y0 - wall + eps, 12]);
  translate([arm_post[0], arm_y0 - eps, arm_post[1] + 4.2]) rotate([-90, 0, 0]) cylinder(d = 2, h = 1.8, $fn = 20);
}

// держатель 18650 стоит на 2 бобышках под своими отверстиями (саморезы 3×12 изнутри, аккумулятор вынут) и на
// 2 рельсах по длинным краям — не качается; упоры по концам ставят его на место ещё до саморезов
bat_boss = [for (s = [-1, 1]) [bat_pos[0] + bat_holder[0] / 2, bat_pos[1] + bat_holder[1] / 2 + s * bat_holes / 2]];
module battery_seat() {
  x0 = bat_pos[0]; x1 = x0 + bat_holder[0]; z0 = bat_pos[1]; z1 = z0 + bat_holder[1]; yb = wall + bat_lift;
  for (p = bat_boss) post(p[0], p[1], wall, yb, d = 8);
  for (x = [x0 + 1, x1 - 3]) box(x, x + 2, wall - eps, yb, z0 + 2, z1 - 2);
  box(x0, x1, wall - eps, yb + 3, z0 - 1.4, z0 - 0.2);
  box(x0, x1, wall - eps, yb + 3, z1 + 0.2, z1 + 1.4);
}

// 29.09: на грань модуля, что к стенке с кнопкой (−x), у верхнего конца припаяны 2 резистора делителя — автор
// выпилил им нишу. Теперь стенка паза с этой стороны — только снизу (chg_res_z), выше открыто до стенки корпуса (7 мм)
chg_res_z = 13;              // сколько сверху модуля открыто под резисторы
module charger_seat() {       // паз: модуль стоит на ребре, гнездом USB-C вниз
  x0 = chg_pos[0] - 0.2; x1 = chg_pos[0] + chg[2] + 0.2; y1 = chg_pos[1] + chg[0] + 0.4; zt = wall + chg[1] + 0.4;
  box(x0 - 1.2, x0, wall - eps, y1, wall - eps, zt - chg_res_z);          // стенка у резисторов — только нижняя часть
  box(x1, x1 + 1.2, wall - eps, y1, wall - eps, zt + 1.2);
  box(x0, x1, wall - eps, chg_pos[1] - 0.2, wall - eps, zt);           // модуль стоит на 6,8 мм от лица
  box(x0, x1 + 1.2, wall - eps, y1, zt, zt + 1.2);                      // сверху упор: вилка не выталкивает модуль
}

// гнездо усилителя. 29.09: было тесно по ширине, гибкая стенка 0,8 (зуб на высоте 4,7) отломилась — изгиб поперёк
// слоёв ~1,9 %. Теперь: зазор 0,35 с каждой стороны; справа жёсткая стенка с козырьком 1,2; слева гибкая стенка,
// отделённая от нижнего упора, плата выше (полочки 6 мм) — зуб на высоте 8,5 от канавки, изгиб ~0,6 %. Ставить так:
// правый край — под козырёк, потом прижать левый. Полочки — посередине: хвостики штырьков у любого края свободны.
amp_c = 0.35;        // зазор по ширине с каждой стороны
amp_ledge = 6;       // плата лежит на 6 мм от лица (было 3)
module amp_seat() {
  x0 = amp_pos[0]; x1 = amp_pos[0] + amp[0]; z0 = amp_pos[1]; z1 = amp_pos[1] + amp[1];
  ledge = wall + amp_ledge; top = ledge + amp_t;
  xl = x0 - amp_c; xr = x1 + amp_c;                                            // внутренние грани стенок
  box(xl - 0.8, xl, wall - 0.8, top + 2.2, z0 + 0.5, z1);                      // левая стенка 0,8 — пружинит; корень в канавке
  box(xr, xr + 1.2, wall - eps, top + 2.4, z0 - 1.4, z1);                      // правая — жёсткая
  box(xl - 0.8, xr, wall - eps, top + 1.0, z0 - 1.4, z0 - 0.2);                // нижний упор (от левой стенки — щель 0,5)
  for (x = [x0 + 0.5, x1 - 2.5]) box(x, x + 2, wall - eps, ledge, z0 + 3, z1 - 3);   // полочки
  // справа козырёк над краем платы: 1,0 внутрь, снизу плоский на 0,4 над платой (выступ 1,0 печатается «нависающей
  // стенкой»; провис 0,1–0,2 зазор выдержит). Скос снизу нельзя: кончик оказался бы ниже корня и начинался в воздухе.
  // Козырёк и зуб — не ближе 3,5 мм к концам: у края с гребёнкой колодки шириной во всю плату.
  translate([0, 0, z0 + 3.5]) linear_extrude(z1 - z0 - 7)
    polygon([[xr + eps, top + 0.4], [xr - 1.0, top + 0.4], [xr - 1.0, top + 0.9], [xr + eps, top + 2.4]]);
  // слева зуб на гибкой стенке: 1,0 внутрь (держит даже сдвинутую вправо плату на 0,3), снизу плоский на 0,35 над
  // платой; сверху скос — плата сама отжимает стенку
  translate([0, 0, z0 + 3.5]) linear_extrude(z1 - z0 - 7)
    polygon([[xl - eps, top + 0.35], [xl + 1.0, top + 0.35], [xl + 1.0, top + 0.55], [xl - eps, top + 1.95]]);
}

module mic_seat() {           // колечко центрирует плату (деталями и капсюлем к лицу, как в v1 — звук проверен)
  translate([0, wall - eps, mic_z]) rotate([-90, 0, 0]) difference() {
    cylinder(d = mic_pcb_d + 0.4 + 2 * 1.2, h = mic_smd - 0.01);
    translate([0, 0, -1]) cylinder(d = mic_pcb_d + 0.4, h = 5);
  }
  for (p = mic_post) post(p[0], p[1], wall, mic_post_y, d = 6);
}

module tie_anchor(z0) {       // мостик под стяжку 2,5 мм: стяжка проходит под ним поперёк канала
  box(0.3, 5.3, wall - eps, 5.6, z0, z0 + 1.2);
  box(0.3, 5.3, wall - eps, 5.6, z0 + 4.8, z0 + 6);
  box(0.3, 5.3, 5.6, 6.8, z0, z0 + 6);
}

module front_parts() {
  // бобышки крышки — вдоль толщины, от лица до крышки
  for (p = boss_pts) translate([p[0], wall - eps, p[1]]) rotate([-90, 0, 0]) cylinder(d = boss_d, h = T - back_t - wall + eps);
  // стакан под кольцо светодиодов
  translate([0, wall - eps, lens_z]) rotate([-90, 0, 0]) difference() {
    cylinder(d = ring_od + 0.8 + 2 * 1.4, h = cup_h, $fn = 120);
    translate([0, 0, -1]) cylinder(d = ring_od + 0.8, h = cup_h + 2, $fn = 120);
  }
  // стойки полки за динамиком
  for (s = [-1, 1]) post(s * shelf_post[0], shelf_post[1], wall, shelf_p, d = 7);   // до плиты полки (проверка 28.09: были на 2,5 короче)
  // утолщение бока под гайку кнопки (лепёшка Ø22)
  translate([-W / 2 + wall - eps, ptt_y, ptt_z]) rotate([0, 90, 0]) cylinder(d = 22, h = 1.2);
  mic_seat();
  board_seat();
  battery_seat();
  charger_seat();
  amp_seat();
  for (z = tie_z) tie_anchor(z);
}

module front_cuts() {
  // проём диска + уступ
  translate([0, -1, lens_z]) rotate([-90, 0, 0]) {
    cylinder(d = lens_open, h = 1 + wall + eps, $fn = 120);      // проём — ровно сквозь лицо
    // низ стакана под кольцо тоже скосом 45° (от проёма к стенке стакана), иначе край стакана начинался бы в воздухе
    translate([0, 0, 1 + wall]) cylinder(d1 = lens_open, d2 = ring_od + 0.8, h = (lens_open - ring_od - 0.8) / 2, $fn = 120);
    cylinder(d = lens_d + 0.4, h = 1 + lens_t - 0.2, $fn = 120);  // гнездо диска…
    // …а под ним скос 45° вместо плоского уступа: при печати лицом на стол уступ висел бы в воздухе.
    translate([0, 0, 1 + lens_t - 0.2 - eps]) cylinder(d1 = lens_d + 0.4, d2 = lens_open, h = (lens_d + 0.4 - lens_open) / 2, $fn = 120);
  }
  // микрофон: отверстие + колечко-метка
  translate([0, -1, mic_z]) rotate([-90, 0, 0]) {
    cylinder(d = mic_hole_d, h = wall + 3, $fn = 24);
    translate([0, 0, 0.48]) difference() { cylinder(d = 7, h = 1); translate([0, 0, -1]) cylinder(d = 5.6, h = 3); }
  }
  // кнопка «говорить» на левом боку
  translate([-W / 2 - 1, ptt_y, ptt_z]) rotate([0, 90, 0]) linear_extrude(wall + 3) teardrop(ptt_hole, 0.1);   // срезанный верх целиком под буртиком кнопки Ø17,9
  // верх: регулятор и тумблер
  translate([enc_xy[0], enc_xy[1], H - wall - 1]) linear_extrude(wall + 2) teardrop(enc_bush_d + 0.4);
  translate([sw_xy[0], sw_xy[1], H - wall - 1]) linear_extrude(wall + 2) teardrop(sw_hole);
  usb_window();
  // прорези 0,5 × 0,8 по обе стороны корня гибкой стенки гнезда усилителя: она гнётся от глубины 0,8 в лице
  for (xa = [amp_pos[0] - amp_c - 1.3, amp_pos[0] - amp_c]) box(xa, xa + 0.5, wall - 0.8, wall + eps, amp_pos[1] + 0.5, amp_pos[1] + amp[1]);
  // надпись — трафаретом: печатается на столе, и «глазки» Ф и А (островки внутри букв) на первых слоях
  // смазались в комплекте 1. Горизонтальная перемычка 0,9 мм соединяет их с лицом — островков нет.
  translate([0, 0.52, logo_z]) rotate([90, 0, 0]) linear_extrude(0.52 + eps) logo();   // глубина 0,52 = 3 слоя
  // меток «ГРОМК» и «ВКЛ» на верхней грани больше нет: 29.09 не пропечатались — автор попросил убрать
  // карман в правой стенке у колодок регулятора (провода загибаются вниз у стенки)
  box(W / 2 - wall - eps, W / 2 - wall + enc_pocket, enc_xy[1] - 8.5, enc_xy[1] + 8.5, H - wall - 14, H - wall + eps);
}

logo_z = 76;
module logo() {   // заглавные Impact размера 8 — высотой 8,8 мм; центр по заглавным (краткая над Й не в счёт)
  translate([0, -4.4]) difference() {
    offset(delta = -0.25) text("АЙ-ШЕФФ", size = 8, font = "Impact", halign = "center", valign = "baseline", spacing = 1.15);   // просветы букв ≥ 2 линий сопла
    translate([-50, 4.4 - 0.45]) square([100, 0.9]);
  }
}

// ушко для шнурка на шею (29.09, просьба автора): сверху справа от ручки регулятора, у лица. Лежит в плоскости лица —
// печатается стоя на столе вместе с лицом, без поддержек; тянет шнурок вдоль слоёв. Проём 5 × 3,5 — шнурок или колечко.
lug_x = 22;        // центр по x (ручка кончается на x = 12, скос лица — на 28,7)
lug_w = 11;        // ширина
lug_h = 6.5;       // высота над верхом
lug_d = 10;        // глубина от лица
module lanyard_lug() {
  xz(0, lug_d) difference() {
    hull() {
      for (s = [-1, 1]) translate([lug_x + s * (lug_w / 2 - 2.5), H + lug_h - 2.5]) circle(r = 2.5, $fn = 32);
      translate([lug_x - lug_w / 2, H - 1]) square([lug_w, 1]);
    }
    translate([lug_x, H + 1.75]) rrect(5, 3.5, 1.2);
  }
}

module front() {
  difference() {
    union() { front_solid(); intersection() { front_parts(); body_outer(); } lanyard_lug(); }
    front_cuts();
    pilots();
    for (p = boss_pts) translate([p[0], T - back_t - 14, p[1]]) rotate([-90, 0, 0]) cylinder(d = screw_pilot, h = 15);
  }
}

// поза печати: лицо на стол (y = 0 → z = 0)
module front_print() { rotate([90, 0, 0]) front(); }   // лицо (y = 0) ложится на стол

// ============================================================
//                  прижимные детали (печатать отдельно)
// ============================================================

// полка за динамиком: 2 самореза в стойки у боковых стенок. Через шайбу-пятачок прижимает магнит динамика
// (0,3 мм натяга: динамик, прокладка, кольцо и белый диск зажаты стопкой); сама плита на 2,2 выше магнита —
// под ней проходят провода с лепестков динамика. На спинке — гнёзда двух клемм, открытые вниз (туда смотрят
// вводы проводов), с рёбрышками-сминалками: клемма вдавливается туго.
clamp_pocket = [clamp[0] + 0.4, clamp[1] + 0.4];
module shelf(r = true) {   // r = false — без сминалок (у них натяг 0,1 по замыслу): для проверок
  x0 = clamp_x[0] - 0.2; x1 = clamp_x[1] + clamp[0] + 0.2; zt = clamp_z - 0.2 + clamp_pocket[1];
  yb = shelf_p + shelf_t - eps; yt = shelf_p + shelf_t + 4;
  difference() {
    union() {
      xz(shelf_p, shelf_t) union() {
        translate([-30.2, 116]) square([60.4, 24]);   // слева у стенки — лепёшка под гайкой кнопки
        translate([x0 - 1.2, 116]) square([x1 - x0 + 2.4, zt + 1.2 - 116]);
      }
      // У 221-415 все 5 вводов — на длинной стороне (29,8 × 9,6): клеммы стоят вводами к БОКОВЫМ стенкам корпуса
      // (5 В — к стенке с кнопкой, GND — к другой), там 11 мм под провода. Поэтому наружные стенки гнёзд низкие
      // (1,5 мм — только чтобы клемма не уехала), высокие — перегородка между клеммами и верх.
      box(x0 - 1.2, x0, yb, yb + 1.5, 116, zt + 1.2);                                 // слева — низкая
      box(clamp_x[0] + clamp[0] + 0.2, clamp_x[1] - 0.2, yb, yt, 116, zt + 1.2);      // перегородка
      box(x1, x1 + 1.2, yb, yb + 1.5, 116, zt + 1.2);                                 // справа — низкая
      box(x0 - 1.2, x1 + 1.2, yb, yt, zt, zt + 1.2);                                  // сверху (снизу открыто)
      if (r) for (cx = clamp_x, z = [clamp_z + 7, clamp_z + 22])                      // сминалки 0,3 у перегородки → натяг 0,1
        translate([cx < 0 ? cx + clamp[0] + 0.3 : cx - 0.3, yb, z]) rotate([-90, 0, 0]) cylinder(d = 0.8, h = 4, $fn = 12);
    }
    for (s = [-1, 1]) translate([s * shelf_post[0], 0, shelf_post[1]]) rotate([-90, 0, 0]) cylinder(d = screw_clear, h = 60, $fn = 24);
    translate([0, 0, lens_z]) rotate([-90, 0, 0]) cylinder(d = 5.4, h = 60, $fn = 30);          // под штырёк пятачка
    for (s = [-1, 1], dx = [-1.5, 1.5]) translate([s * 25 + dx - 0.8, shelf_p - 1, 131]) cube([1.6, shelf_t + 2, 3.2]);   // под стяжки
    // вырез в углу под гайку кнопки «говорить» (M16, до Ø22 по углам): без него угол полки ложится на гайку
    translate([-W / 2 + wall + 1.2 - 0.5, ptt_y, ptt_z]) rotate([0, 90, 0]) cylinder(d = 25, h = 6);
  }
}
module shelf_print() { y_on_bed(shelf_p) shelf(); }

// шайба-пятачок Ø20: давит на плоское дно магнита, лепестки выводов по краю (Ø28,7) не задевает;
// штырёк в отверстии полки держит её по центру (отдельная деталь — выступ на полке висел бы в воздухе при печати)
module spk_puck() {
  translate([0, shelf_y, lens_z]) rotate([-90, 0, 0]) {
    cylinder(d = 20, h = shelf_p - shelf_y - 0.02);
    cylinder(d = 5, h = shelf_p - shelf_y + shelf_t - 0.4, $fn = 30);
  }
}
module spk_puck_print() { y_on_bed(shelf_y) spk_puck(); }

// лапка платы ESP: прижимает плату посередине между рядами штырьков (там, где штырьки 16–18 свободны
// с обеих сторон), сама держится на стойке в канале: 1 саморез + штырёк-фиксатор.
arm_y0 = dk_y + 1.6 + dk_pin + 0.8;       // над концами штырьков
arm_z = dk_pos[1] + dk_end + 16.5 * 2.54;  // середина между штырьками 16 и 18
module dk_arm() {
  xm = dk_pos[0] + dk[0] / 2;
  difference() {
    union() {
      box(arm_post[0] - 3, arm_post[0] + 3, arm_y0, arm_y0 + 3, arm_post[1] - 6, arm_post[1] + 6);
      box(xm - 3.5, arm_post[0] - 3 + eps, arm_y0, arm_y0 + 3, arm_z - 3, arm_z + 3);
      box(xm - 3.5, xm + 3.5, dk_y + 1.6 - 0.25, arm_y0 + eps, arm_z - 3, arm_z + 3);  // палец: 0,25 мм натяга
    }
    translate([arm_post[0], 0, arm_post[1]]) rotate([-90, 0, 0]) cylinder(d = screw_clear, h = 60, $fn = 24);
    translate([arm_post[0], 0, arm_post[1] + 4.2]) rotate([-90, 0, 0]) cylinder(d = 2.4, h = 60, $fn = 20);
  }
}
// «ушки» в один слой (0,2 мм): мелкая деталь держится за стол крепче (29.09 лапка сорвалась со стола); отламываются
module ears(pts, d = 9) { for (p = pts) translate([p[0], p[1], 0]) cylinder(d = d, h = 0.2, $fn = 32); }
module dk_arm_print() { y_on_bed(arm_y0 + 3, true) dk_arm(); ears([[dk_pos[0] + dk[0] / 2 - 3.5, arm_z], [arm_post[0] + 5, arm_post[1] - 6], [arm_post[0] + 5, arm_post[1] + 6]], 7); }

// планка микрофона: лежит вдоль z между двумя столбиками колодок (зазор 1 с каждой стороны), двумя лапками
// давит на край платы над и под столбиками. Саморезы — в стойки под и над микрофоном.
// 29.09: шириной 6 она не прошла между колодками — середина теперь 3 мм, концы под саморезы остались широкими.
mic_post_y = wall + 7.6;
mic_cap_w = 3;      // середина (и лапки) — между колодками
mic_cap_end = 6.5;  // концы на стойках: саморез 3 в отверстии 3,4
mic_foot = 1.7;    // толщина лапки (было 1,2 — 29.09 планка не напечаталась: лапка 1,2 × 6 высотой 6 мм — тонкая «пластина»); угол лапки на r 6,71 — внутри колечка Ø13,8
module mic_cap() {
  difference() {
    union() {
      box(-mic_cap_w / 2, mic_cap_w / 2, mic_post_y, mic_post_y + 2.5, mic_post[0][1] - 3.5, mic_post[1][1] + 3.5);
      for (p = mic_post) box(-mic_cap_end / 2, mic_cap_end / 2, mic_post_y, mic_post_y + 2.5, p[1] - 3.5, p[1] + 3.5);
      for (s = [-1, 1]) box(-mic_cap_w / 2, mic_cap_w / 2, wall + mic_smd - 0.1, mic_post_y + eps,
                            mic_z + s * 4.3 - (s > 0 ? 0 : mic_foot), mic_z + s * 4.3 + (s > 0 ? mic_foot : 0));   // лапки: натяг 0,1
    }
    for (p = mic_post) translate([p[0], 0, p[1]]) rotate([-90, 0, 0]) cylinder(d = screw_clear, h = 60, $fn = 24);
  }
}
module mic_cap_print() { y_on_bed(mic_post_y + 2.5, true) mic_cap(); ears([[0, mic_post[0][1] - 3.5], [0, mic_post[1][1] + 3.5]]); }

// ============================================================
//                        задняя крышка
// ============================================================

module back() {
  difference() {
    union() {
      intersection() {
        body_outer();
        translate([-W, T - back_t, -1]) cube([2 * W, back_t + 1, H + 2]);
      }
      // бортик — входит внутрь лицевой части
      translate([0, T - back_t + eps, 0]) rotate([90, 0, 0]) linear_extrude(lip_h)
        difference() {
          translate([0, H / 2]) rrect(inner_w - 0.6, H - 2 * wall - 0.6, r_v - wall);
          translate([0, H / 2]) rrect(inner_w - 0.6 - 2 * lip_t, H - 2 * wall - 0.6 - 2 * lip_t, r_v - wall - lip_t);
          for (p = boss_pts) translate([p[0], p[1]]) circle(d = boss_d + 1.2);
        }
    }
    // саморезы (потай снаружи)
    for (p = boss_pts) translate([p[0], T + 0.5, p[1]]) rotate([90, 0, 0]) {
      cylinder(d = screw_clear, h = back_t + 3);
      cylinder(d1 = 7.2, d2 = 0, h = 3.6);          // на плоскости спины — Ø6,2 под потайную головку
    }
    // надпись на крышке
    translate([0, T - 0.5, H / 2 + 20]) rotate([-90, 180, 0]) linear_extrude(1)
      text("WiFi-рация", size = 6, font = "Impact", halign = "center", valign = "center");
  }
}

module back_print() { translate([0, 0, T]) rotate([-90, 0, 0]) back(); }

// ============================================================
//                     диск, прокладка, ручка
// ============================================================

module grille(r_out, hole = 1.9, pitch = 3.2) {
  n = ceil(r_out / pitch) + 1;
  for (i = [-n:n], j = [-n:n]) {
    x = i * pitch + (j % 2) * pitch / 2;
    y = j * pitch * sqrt(3) / 2;
    if (sqrt(x * x + y * y) + hole / 2 <= r_out) translate([x, y, 0]) cylinder(d = hole, h = 10, center = true, $fn = 16);
  }
}

module lens() {
  difference() {
    cylinder(d = lens_d, h = lens_t, $fn = 120);
    grille(grille_r);
  }
}

spacer_t = 3.0;
module spacer() {
  // сторона z = 0 — к кольцу светодиодов, сверху — квадратное гнездо фланца динамика
  difference() {
    cylinder(d = ring_od + 0.4, h = spacer_t, $fn = 120);
    translate([0, 0, -1]) cylinder(d = 28, h = spacer_t + 2, $fn = 90);            // окно для звука
    translate([-(spk_sq + 0.6) / 2, -(spk_sq + 0.6) / 2, spacer_t - 2.0]) cube([spk_sq + 0.6, spk_sq + 0.6, 3]);
    // вырез под провода кольца (его площадки — на обороте); прокладку поворачивают вырезом к площадкам кольца
    translate([ring_id / 2 - 1, -5, -1]) cube([12, 10, 1.8]);
    translate([ring_od / 2 - 3, -5, -1]) cube([6, 10, spacer_t + 2]);
  }
}

module knob() {
  difference() {
    union() {
      cylinder(d = knob_d - 1.6, h = knob_h);
      for (a = [0:20:359]) rotate([0, 0, a]) translate([knob_d / 2 - 1.2, 0, 1.5]) cylinder(d = 1.8, h = knob_h - 3, $fn = 12);
      cylinder(d = knob_d, h = 1.5);
    }
    translate([0, 0, -eps]) d_hole(shaft_d, shaft_flat, shaft_depth);
    translate([-0.8, knob_d / 2 - 6.5, knob_h - 0.8]) cube([1.6, 5, 1]);
  }
}
module knob_print() { translate([0, 0, knob_h]) rotate([180, 0, 0]) knob(); }
// отверстие вала «буквой D» с фаской на входе
module d_hole(d, flat, h) {
  intersection() {
    union() { cylinder(d = d, h = h, $fn = 40); cylinder(d1 = d + 2 * shaft_chamfer, d2 = d, h = shaft_chamfer, $fn = 40); }
    translate([-d / 2 - 1, -d, 0]) cube([flat + 1, 2 * d, h]);
  }
}
// пробник вала: три отверстия — какое сядет на вал плотно, но без усилия; цифры сверху (≈5 минут)
gauge = [[6.2, 4.6], [6.35, 4.75], [6.5, 4.9]];
module shaft_gauge() {
  difference() {
    translate([-4, -10, 0]) cube([3 * 11 + 2, 16, 6]);
    for (i = [0:2]) translate([i * 11 + 4, 0, -eps]) d_hole(gauge[i][0], gauge[i][1], 7);
    for (i = [0:2]) translate([i * 11 + 4, -7.4, 5.4]) linear_extrude(1) text(str(i + 1), size = 3.5, font = "Impact", halign = "center", valign = "center");
  }
}

// кольцо-проставка регулятора: надевается на втулку изнутри, 2 шт. на рацию
module enc_spacer() { difference() { cylinder(d = 12, h = enc_spacer_t); translate([0, 0, -1]) cylinder(d = enc_bush_d + 0.4, h = enc_spacer_t + 2); } }

module coupon() {
  difference() {
    translate([-42, -36, 0]) cube([84, 72, wall]);
    translate([0, 0, -1]) {
      cylinder(d = lens_open, h = wall + 2, $fn = 120);
      translate([0, 0, wall - lens_t - 0.2 + 1]) cylinder(d = lens_d + 0.4, h = 5, $fn = 120);
    }
    for (p = [[-31, -25, ptt_hole], [-33, 27, sw_hole], [33, 27, enc_bush_d + 0.4], [33, -27, mic_hole_d]])
      translate([p[0], p[1], -1]) cylinder(d = p[2], h = wall + 2);
  }
}

// ============================================================
//                  муляжи (картинки и проверки)
// ============================================================

module d_speaker() { translate([0, lens_t + ring_h + spacer_t - 2.0, lens_z]) rotate([-90, 0, 0]) {
  translate([-spk_sq / 2, -spk_sq / 2, 0]) cube([spk_sq, spk_sq, spk_flange]); cylinder(d = spk_body_d, h = spk_depth); } }
module d_ring() { translate([0, lens_t, lens_z]) rotate([-90, 0, 0]) difference() { cylinder(d = ring_od, h = ring_h); translate([0, 0, -1]) cylinder(d = ring_id, h = 5); } }
// плата ESP: модуль и USB-C к лицу, штырьки к спине; колодки Dupont только на занятых штырьках
dk_used_l = [1, 2, 4, 5, 6, 7, 8, 9, 10, 11, 12, 21, 22];   // 3V3 3V3 · 4 5 6 · 7 15 16 17 · 18 · 8 · 5V GND
dk_used_r = [1, 4, 5, 6, 7, 21, 22];                        // GND · 1 · 2 42 41 · GND GND
function pin_z(k) = dk_pos[1] + dk_end + (k - 0.5) * 2.54;
module d_board() {
  x0 = dk_pos[0]; x1 = x0 + dk[0]; z0 = dk_pos[1]; z1 = z0 + dk[1]; yp = dk_y + 1.6; xc = (x0 + x1) / 2;
  box(xc - 9, xc + 9, dk_y - dk_mod, dk_y, z0 - dk_ant, z0 + 19.2);     // модуль: антенна выступает за край платы
  box(x0 + 3.5, x1 - 3.5, dk_y - dk_usb, dk_y, z1 - 7.5, z1 + 0.8);    // гнёзда USB-C (чуть выступают)
  box(x0 + 5, x1 - 5, dk_y - 2, dk_y, z0 + 20, z1 - 8);                 // мелкие детали
  box(x0, x1, dk_y, yp, z0, z1);                                        // плата
  for (xr = [x0, x1 - 2.54]) {
    box(xr, xr + 2.54, yp, yp + 2.5, z0 + dk_end, z1 - dk_end);         // пластик гребёнок
    box(xr + 0.95, xr + 1.59, yp + 2.5, yp + dk_pin, z0 + dk_end, z1 - dk_end);   // штырьки
    box(xr + 0.95, xr + 1.59, dk_y - 1.5, dk_y, z0 + dk_end, z1 - dk_end);        // хвостики со стороны лица
  }
  // плата лежит модулем к лицу, антенной вниз: «левый» ряд (3V3, 4…8, 5V — если держать надписями к себе, USB вниз)
  // оказывается у канала (x1), «правый» (G, 1, 2, 42, 41) — у стенки с кнопкой (x0)
  for (k = dk_used_l) box(x1 - 2.54, x1, yp + 2.5, yp + 2.5 + 16.5, pin_z(k) - 1.27, pin_z(k) + 1.27);   // колодки + провод
  for (k = dk_used_r) box(x0, x0 + 2.54, yp + 2.5, yp + 2.5 + 16.5, pin_z(k) - 1.27, pin_z(k) + 1.27);
}
module d_battery() { box(bat_pos[0], bat_pos[0] + bat_holder[0], wall + bat_lift, wall + bat_lift + bat_holder[2], bat_pos[1], bat_pos[1] + bat_holder[1]); }
module d_charger() { box(chg_pos[0], chg_pos[0] + chg[2], chg_pos[1], chg_pos[1] + chg[0], wall + 0.01, wall + chg[1]); }   // стоит на дне
// усилитель: гребёнка по верхнему краю (к плате ESP), колодки Dupont к спине
module d_amp() {
  x0 = amp_pos[0]; x1 = x0 + amp[0]; z0 = amp_pos[1]; z1 = z0 + amp[1]; y0 = wall + amp_ledge + 0.01;
  box(x0, x1, y0, y0 + amp_t, z0, z1);
  box(x0 + 1, x1 - 1, y0 + amp_t, y0 + amp_t + 2, z0 + 1, z1 - 3.5);
  box(x0 + 0.2, x1 - 0.2, y0 + amp_t, y0 + amp_t + 17, z1 - 2.54, z1);   // гребёнка 7 штырьков + колодки
  box(x0 + 0.7, x1 - 0.7, y0 - 2, y0, z1 - 2.54, z1);                    // хвостики 7 штырьков снизу
  box(x0 + 0.7, x1 - 0.7, y0 - 2, y0, z0, z0 + 2.54);                    // …или у нижнего края (рация 1 — гребёнкой вниз)
  box(x0 + 0.2, x1 - 0.2, y0 + amp_t, y0 + amp_t + 17, z0, z0 + 2.54);   // и колодки там же
}
module d_ptt() {   // корпус кнопки + гайка изнутри (Ø22 по углам, 3 мм)
  translate([-W / 2 + wall + 1.2 + eps, ptt_y, ptt_z]) rotate([0, 90, 0]) { cylinder(d = ptt_d, h = ptt_body); cylinder(d = 22, h = 3, $fn = 6); }
}
// регулятор: гребёнка — ВПРАВО (+x), штырьки целиком, провода припаяны и загнуты вниз
module d_enc() {
  translate([enc_xy[0] - (enc_pcb[0] - enc_pin_side), enc_xy[1] - enc_pcb[1] / 2, H - wall - enc_drop - 9.5 - eps]) cube([enc_pcb[0], enc_pcb[1], 9.5]);
  translate([enc_xy[0] + enc_pin_side - eps, enc_xy[1] - 6.5, H - wall - enc_drop - 9.5 - eps]) cube([enc_plug, 13, 4.5]);   // колодки мама-мама
}
module d_switch() { translate([sw_xy[0] - sw_body[0] / 2, sw_xy[1] - sw_body[1] / 2, H - wall - sw_depth - eps]) cube([sw_body[0], sw_body[1], sw_depth]); }
module d_mic() {   // деталями к лицу; 2 столбика по 3 штырька с колодками — к спине
  translate([0, wall, mic_z]) rotate([-90, 0, 0]) cylinder(d = mic_pcb_d, h = mic_smd);
  for (s = [-1, 1]) box(s * mic_cols - 1.27, s * mic_cols + 1.27, wall + mic_smd, wall + mic_smd + 2.5 + 16.5, mic_z - 3.81, mic_z + 3.81);
}
module d_clamps() { for (cx = clamp_x) box(cx, cx + clamp[0], shelf_p + shelf_t + 0.01, shelf_p + shelf_t + clamp[2], clamp_z, clamp_z + clamp[1]); }
module inside_parts() { d_speaker(); d_ring(); d_board(); d_battery(); d_charger(); d_amp(); d_ptt(); d_enc(); d_switch(); d_mic(); d_clamps(); }
module clamp_parts(r = true) { shelf(r); spk_puck(); dk_arm(); mic_cap(); }

// ============================================================
//                             части
// ============================================================

if (part == "front") front();
else if (part == "front_print") front_print();
else if (part == "back") back();
else if (part == "back_print") back_print();
else if (part == "shelf") shelf();
else if (part == "shelf_print") shelf_print();
else if (part == "dk_arm") dk_arm();
else if (part == "dk_arm_print") dk_arm_print();
else if (part == "spk_puck") spk_puck();
else if (part == "spk_puck_print") spk_puck_print();
else if (part == "shaft_gauge") shaft_gauge();
else if (part == "mic_cap") mic_cap();
else if (part == "mic_cap_print") mic_cap_print();
else if (part == "clamp_parts") clamp_parts();
else if (part == "lens") lens();
else if (part == "spacer") spacer();
else if (part == "knob") knob();
else if (part == "knob_print") knob_print();
else if (part == "coupon") coupon();
else if (part == "enc_spacer") enc_spacer();
// пробник кромки: отрезок лицевой части 36 мм с надписью и боками на 12 мм (≈25 мин) — проверить скос и трафарет
else if (part == "edge_test") rotate([90, 0, 0]) intersection() { front(); translate([-W, -1, logo_z - 18]) cube([2 * W, 13, 36]); }
else if (part == "logo2d") logo();
else if (part == "enc_spacer_print") for (i = [0:5]) translate([(i % 3) * 16, floor(i / 3) * 16, 0]) enc_spacer();   // 6 шт. на три рации
else if (part == "lens_placed") translate([0, lens_t, lens_z]) rotate([90, 0, 0]) lens();
else if (part == "knob_placed") translate([enc_xy[0], enc_xy[1], H + 4]) knob();
else if (part == "inside") inside_parts();
else if (part == "d_speaker") d_speaker();
else if (part == "d_ring") d_ring();
else if (part == "d_board") d_board();
else if (part == "d_battery") d_battery();
else if (part == "d_charger") d_charger();
else if (part == "d_amp") d_amp();
else if (part == "d_ptt") d_ptt();
else if (part == "d_enc") d_enc();
else if (part == "d_switch") d_switch();
else if (part == "d_mic") d_mic();
else if (part == "d_clamps") d_clamps();
else if (part == "assembly") {
  color("#2b2d2c") front();
  color("#3a3c3b") back();
  color("#f2f0ea") translate([0, lens_t, lens_z]) rotate([90, 0, 0]) lens();
  color("#1b1b1b") translate([enc_xy[0], enc_xy[1], H + 4]) knob();
  color("#b0b0b0") translate([-W / 2 - 3, ptt_y, ptt_z]) rotate([0, 90, 0]) cylinder(d = 16, h = 3.4);
  color("#c0c0c0") translate([sw_xy[0], sw_xy[1], H]) cylinder(d = 3, h = 10);
}
// Проверки: экспорт должен быть ПУСТЫМ (детали не лезут друг в друга и в стенки)
else if (part == "check_inside") {
  // попарные пересечения муляжей
  intersection() { d_board(); union() { d_battery(); d_ptt(); d_speaker(); d_charger(); d_amp(); d_mic(); d_enc(); d_switch(); d_clamps(); } }
  intersection() { d_battery(); union() { d_ptt(); d_speaker(); d_charger(); d_amp(); d_mic(); d_enc(); d_switch(); d_clamps(); } }
  intersection() { d_speaker(); union() { d_ptt(); d_enc(); d_switch(); d_mic(); d_clamps(); } }
  intersection() { d_ptt(); union() { d_ring(); d_enc(); d_switch(); d_clamps(); } }
  intersection() { d_mic(); union() { d_charger(); d_amp(); } }
  intersection() { d_charger(); d_amp(); }
  intersection() { d_clamps(); union() { d_ring(); d_enc(); d_switch(); d_charger(); d_amp(); d_mic(); } }
  intersection() { d_enc(); d_switch(); }
}
// крышка и лицевая часть не должны заходить друг в друга
else if (part == "check_lid") intersection() { front(); translate([0, 0.02, 0]) back(); }   // 0,02 — плоскость стыка не в счёт
else if (part == "check_walls") {
  intersection() { inside_parts(); union() { front(); back(); } }
  intersection() { translate([0, 0.5, 0]) d_battery(); back(); }   // держатель не ближе 0,5 к крышке (с её бортиком)
}
// прижимные детали: не лезут в стенки, в крышку и в муляжи. Там, где они ПРИЖИМАЮТ (полка — магнит динамика,
// палец лапки — плату, планка — плату микрофона), натяг снят сдвигом на 0,7 мм к спине;
// саморезы садятся на свои стойки — это тоже не пересечение (сдвиг 0,02).
else if (part == "check_parts") {
  intersection() { translate([0, 0.02, 0]) clamp_parts(false); union() { front(); back(); } }
  intersection() { translate([0, 0.7, 0]) clamp_parts(false); union() { d_speaker(); d_board(); d_mic(); } }
  intersection() { clamp_parts(false); union() { d_ring(); d_battery(); d_charger(); d_amp(); d_ptt(); d_enc(); d_switch(); d_clamps(); } }
  intersection() { shelf(false); union() { dk_arm(); mic_cap(); } }
  intersection() { spk_puck(); union() { dk_arm(); mic_cap(); } }
  intersection() { dk_arm(); mic_cap(); }
}
// сборка для картинок: корпус без крышки + муляжи + прижимные детали
else if (part == "open_view") { front(); inside_parts(); clamp_parts(); }
